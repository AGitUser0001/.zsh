builtin enable emulate zmodload zparseopts zselect strftime print command
builtin emulate -LR zsh
builtin zmodload zsh/zutil zsh/zselect zsh/datetime
builtin setopt pipefail

local -a opt_multi opt_help opt_ext
local -a muxer_args streamlink_args

builtin zparseopts -D -E -F -- \
    m=opt_multi \
    -multi=opt_multi \
    e:=opt_ext \
    -ext:=opt_ext \
    h=opt_help \
    -help=opt_help ||
    return 2

if (( ${#opt_help} )); then
    builtin print -r -- \
        'usage: yt-timelapse [-m|--multi] [-e|--ext EXT] <url> [output]' \
        '' \
        'examples:' \
        '  yt-timelapse URL' \
        '  yt-timelapse URL video' \
        '  yt-timelapse URL video.mp4' \
        '  yt-timelapse --ext mkv URL' \
        '  yt-timelapse --multi URL' \
        '  yt-timelapse --multi --ext ts URL'
    return 0
fi

integer multi=${#opt_multi}
integer part=0
integer rc=0

local url=''
local output=''
local output_ext=''
local extension='mts'
local explicit_ext=''
local current_output=''
local timestamp=''
local stream_url=''
local playlist=''
local ext_lower=''

#
# Resolve --ext.
#
if (( ${#opt_ext} )); then
    explicit_ext=${opt_ext[-1]}
    explicit_ext=${explicit_ext#.}

    if [[ -z $explicit_ext || $explicit_ext == */* ]]; then
        builtin print -u2 -r -- \
            "yt-timelapse: invalid extension: ${explicit_ext:-<empty>}"
        return 2
    fi
fi

#
# Resolve positional arguments and filename.
#
if (( multi )); then
    if (( $# != 1 )); then
        builtin print -u2 -r -- \
            'yt-timelapse: --multi takes exactly one URL; filenames are automatic'
        return 2
    fi

    url=$1
    extension=${explicit_ext:-mts}
else
    if (( $# < 1 || $# > 2 )); then
        builtin print -u2 -r -- \
            'usage: yt-timelapse [-m|--multi] [-e|--ext EXT] <url> [output]'
        return 2
    fi

    url=$1
    output=${2-}

    if [[ -n $output ]]; then
        output_ext=${output:t:e}

        if [[ -n $output_ext ]]; then
            #
            # Filename already chooses the container.
            #
            extension=$output_ext

            if [[ -n $explicit_ext &&
                  ${(L)explicit_ext} != ${(L)output_ext} ]]; then
                builtin print -u2 -r -- \
                    "yt-timelapse: --ext .${explicit_ext} conflicts with output .${output_ext}"
                return 2
            fi
        else
            #
            # Explicit basename but no extension.
            #
            extension=${explicit_ext:-mts}
            output="${output}.${extension}"
        fi
    else
        extension=${explicit_ext:-mts}
    fi
fi

#
# Add muxer-specific niceties while still letting FFmpeg infer
# the actual output format from the filename.
#
ext_lower=${(L)extension}
muxer_args=()

case $ext_lower {
    (ts|mts|m2t|m2ts)
        #
        # Make an actively-growing transport stream easier to join/read.
        #
        muxer_args+=(
            -mpegts_flags +pat_pmt_at_frames
        )
        ;;

    (mp4|m4v|mov)
        #
        # Apple-friendly HEVC tag and nicer finalized files.
        # Note: these aren't as useful as MPEG-TS while still growing.
        #
        muxer_args+=(
            -tag:v hvc1
            -movflags +faststart
        )
        ;;
}

while (( 1 )); do
    #
    # --multi is specifically "follow this live broadcast".
    #
    # Before each new chunk, resolve its current HLS presentation and
    # ensure it has not become an archived VOD. Single-shot mode does
    # none of this and can therefore happily timelapse a VOD.
    #
    if (( multi )); then
        while (( 1 )); do
            stream_url=$(
                builtin command streamlink \
                    --stream-url \
                    "$url" best \
                    2>/dev/null
            )
            rc=$?

            if (( rc )) || [[ -z $stream_url ]]; then
                builtin print -u2 -r -- \
                    'yt-timelapse: stream unavailable; retrying in 2s'
                builtin zselect -t 200
                continue
            fi

            playlist=$(
                builtin command /usr/bin/curl \
                    -LfsS \
                    --max-time 15 \
                    "$stream_url" \
                    2>/dev/null
            )
            rc=$?

            if (( rc )) || [[ -z $playlist ]]; then
                builtin print -u2 -r -- \
                    'yt-timelapse: could not inspect stream; retrying in 2s'
                builtin zselect -t 200
                continue
            fi

            #
            # Defensive: if Streamlink gave us a multivariant/master
            # playlist, resolve "best" from that before deciding whether
            # the presentation has ended.
            #
            if [[ $playlist == *'#EXT-X-STREAM-INF'* ]]; then
                stream_url=$(
                    builtin command streamlink \
                        --stream-url \
                        "$stream_url" best \
                        2>/dev/null
                )
                rc=$?

                if (( rc )) || [[ -z $stream_url ]]; then
                    builtin print -u2 -r -- \
                        'yt-timelapse: could not resolve media playlist; retrying in 2s'
                    builtin zselect -t 200
                    continue
                fi

                playlist=$(
                    builtin command /usr/bin/curl \
                        -LfsS \
                        --max-time 15 \
                        "$stream_url" \
                        2>/dev/null
                )
                rc=$?

                if (( rc )) || [[ -z $playlist ]]; then
                    builtin print -u2 -r -- \
                        'yt-timelapse: could not inspect media playlist; retrying in 2s'
                    builtin zselect -t 200
                    continue
                fi
            fi

            #
            # This is the thing that prevents:
            #
            # live ends
            # → Streamlink reopens archived broadcast from t=0
            # → eats whole VOD at warp speed
            # → repeats forever :3
            #
            if [[ $playlist == *'#EXT-X-ENDLIST'* ||
                  $playlist == *'#EXT-X-PLAYLIST-TYPE:VOD'* ]]; then
                if (( part )); then
                    builtin print -u2 -r -- \
                        'yt-timelapse: broadcast ended; finished'
                    return 0
                fi

                builtin print -u2 -r -- \
                    'yt-timelapse: --multi requires a currently-live broadcast'
                return 3
            fi

            #
            # Looks sufficiently like an active media playlist.
            #
            if [[ $playlist == '#EXTM3U'* &&
                  ( $playlist == *'#EXTINF:'* ||
                    $playlist == *'#EXT-X-MEDIA-SEQUENCE:'* ) ]]; then
                break
            fi

            builtin print -u2 -r -- \
                'yt-timelapse: unclear playlist state; retrying in 2s'
            builtin zselect -t 200
        done
    fi

    (( part++ ))

    #
    # Construct filename.
    #
    if (( multi )); then
        builtin strftime -s timestamp '%Y-%m-%d_%H-%M-%S'
        current_output="${timestamp}_part_${part}_timelapse.${extension}"
    elif [[ -n $output ]]; then
        current_output=$output
    else
        builtin strftime -s timestamp '%Y-%m-%d_%H-%M-%S'
        current_output="${timestamp}_timelapse.${extension}"
    fi

    if (( multi )); then
        builtin print -u2 -r -- \
            "yt-timelapse: recording part ${part} -> ${current_output}"
    else
        builtin print -u2 -r -- \
            "yt-timelapse: recording -> ${current_output}"
    fi

    #
    # Multi gets a little patience if the broadcast is temporarily
    # unavailable between our check and the actual opening.
    #
    streamlink_args=()

    if (( multi )); then
        streamlink_args+=(
            --retry-streams 2
            --retry-max 0
        )
    fi

    builtin command streamlink \
        "${streamlink_args[@]}" \
        "$url" best -O |
    builtin command ffmpeg \
        -fflags nobuffer \
        -i - \
        -vf 'fps=1,settb=expr=1/30,setpts=expr=N:strip_fps=1' \
        -an \
        -fps_mode passthrough \
        -enc_time_base filter \
        -c:v hevc_videotoolbox \
        -bf 0 \
        -realtime 1 \
        -q:v 65 \
        -pix_fmt yuv420p \
        -flush_packets 1 \
        -avioflags direct \
        "${muxer_args[@]}" \
        "$current_output"

    rc=$?

    #
    # Single mode = one run only, regardless of whether URL was
    # live or VOD.
    #
    if (( ! multi )); then
        return $rc
    fi

    #
    # Don't resurrect after deliberate interruption.
    #
    if (( rc == 130 || rc == 143 )); then
        return $rc
    fi

    builtin print -u2 -r -- \
        "yt-timelapse: part ${part} ended; checking for continuation in 2s"

    builtin zselect -t 200
done
