builtin enable emulate zmodload command print strftime zparseopts zselect
builtin emulate -LR zsh
builtin zmodload zsh/zutil zsh/datetime zsh/zselect
builtin setopt pipefail

local -a opt_multi opt_help

builtin zparseopts -D -E -F -- \
    m=opt_multi \
    -multi=opt_multi \
    h=opt_help \
    -help=opt_help ||
    return 2

if (( ${#opt_help} )); then
    builtin print -r -- \
        'usage: yt-timelapse [-m|--multi] <url> [output.ts]' \
        '' \
        'single:' \
        '  yt-timelapse <url>' \
        '  yt-timelapse <url> output.ts' \
        '' \
        'multi/live:' \
        '  yt-timelapse --multi <url>'
    return 0
fi

integer multi=${#opt_multi}
integer part=0
integer rc=0

local url=''
local output=''
local current_output=''
local timestamp=''
local stream_url=''
local playlist=''

if (( multi )); then
    if (( $# != 1 )); then
        builtin print -u2 -r -- \
            'yt-timelapse: --multi takes exactly one URL; filenames are automatic'
        return 2
    fi

    url=$1
else
    if (( $# < 1 || $# > 2 )); then
        builtin print -u2 -r -- \
            'usage: yt-timelapse [-m|--multi] <url> [output.ts]'
        return 2
    fi

    url=$1
    output=${2-}
fi

while (( 1 )); do
    #
    # Multi mode is live-follow mode.
    #
    # Before each new recording process, resolve the currently selected
    # HLS playlist and make sure YouTube hasn't turned the broadcast into
    # a finished replay/VOD.
    #
    if (( multi )); then
        while (( 1 )); do
            stream_url=$(
                builtin command streamlink \
                    --stream-url \
                    "$url" best \
                    2>/dev/null
            )
            rc=$?

            if (( rc )) || [[ -z $stream_url ]]; then
                builtin print -u2 -r -- \
                    'yt-timelapse: live stream temporarily unavailable; retrying in 2s'
                builtin zselect -t 200
                continue
            fi

            playlist=$(
                builtin command /usr/bin/curl \
                    -LfsS \
                    --max-time 15 \
                    "$stream_url" \
                    2>/dev/null
            )
            rc=$?

            if (( rc )) || [[ -z $playlist ]]; then
                builtin print -u2 -r -- \
                    'yt-timelapse: could not inspect playlist; retrying in 2s'
                builtin zselect -t 200
                continue
            fi

            #
            # Defensive case: if --stream-url somehow yielded a
            # multivariant/master playlist, ask Streamlink to select
            # "best" from that playlist as well.
            #
            if [[ $playlist == *'#EXT-X-STREAM-INF'* ]]; then
                stream_url=$(
                    builtin command streamlink \
                        --stream-url \
                        "$stream_url" best \
                        2>/dev/null
                )
                rc=$?

                if (( rc )) || [[ -z $stream_url ]]; then
                    builtin print -u2 -r -- \
                        'yt-timelapse: could not resolve media playlist; retrying in 2s'
                    builtin zselect -t 200
                    continue
                fi

                playlist=$(
                    builtin command /usr/bin/curl \
                        -LfsS \
                        --max-time 15 \
                        "$stream_url" \
                        2>/dev/null
                )
                rc=$?

                if (( rc )) || [[ -z $playlist ]]; then
                    builtin print -u2 -r -- \
                        'yt-timelapse: could not inspect media playlist; retrying in 2s'
                    builtin zselect -t 200
                    continue
                fi
            fi

            #
            # Finished HLS presentations must not be reopened in --multi
            # mode, otherwise we'd speedrun the archived broadcast again.
            #
            if [[ $playlist == *'#EXT-X-ENDLIST'* ||
                  $playlist == *'#EXT-X-PLAYLIST-TYPE:VOD'* ]]; then
                if (( part )); then
                    builtin print -u2 -r -- \
                        'yt-timelapse: broadcast ended; finished'
                    return 0
                fi

                builtin print -u2 -r -- \
                    'yt-timelapse: URL is an ended broadcast/VOD; --multi requires live HLS'
                return 3
            fi

            #
            # Looks like an actual media playlist and isn't ended.
            #
            if [[ $playlist == '#EXTM3U'* &&
                  ( $playlist == *'#EXTINF:'* ||
                    $playlist == *'#EXT-X-MEDIA-SEQUENCE:'* ) ]]; then
                break
            fi

            builtin print -u2 -r -- \
                'yt-timelapse: playlist state is unclear; retrying in 2s'
            builtin zselect -t 200
        done
    fi

    (( part++ ))

    #
    # Single mode may use an explicit name.
    # Multi always gets a fresh automatic name.
    #
    if (( multi )) || [[ -z $output ]]; then
        builtin strftime -s timestamp '%Y-%m-%d_%H-%M-%S'

        if (( multi )); then
            current_output="${timestamp}_part_${part}_timelapse.ts"
        else
            current_output="${timestamp}_timelapse.ts"
        fi
    else
        current_output=$output
    fi

    if (( multi )); then
        builtin print -u2 -r -- \
            "yt-timelapse: recording part ${part} -> ${current_output}"
    else
        builtin print -u2 -r -- \
            "yt-timelapse: recording -> ${current_output}"
    fi

    builtin command streamlink \
        "$url" best -O |
    builtin command ffmpeg \
        -fflags nobuffer \
        -i - \
        -vf 'fps=1,settb=expr=1/30,setpts=expr=N:strip_fps=1' \
        -an \
        -fps_mode passthrough \
        -enc_time_base filter \
        -c:v hevc_videotoolbox \
        -bf 0 \
        -realtime 1 \
        -q:v 65 \
        -pix_fmt yuv420p \
        -flush_packets 1 \
        -avioflags direct \
        -mpegts_flags +pat_pmt_at_frames \
        -f mpegts \
        "$current_output"

    rc=$?

    #
    # Normal mode means exactly one run, live or VOD.
    #
    if (( ! multi )); then
        return $rc
    fi

    #
    # Don't interpret Ctrl-C / TERM as "please reconnect".
    #
    if (( rc == 130 || rc == 143 )); then
        return $rc
    fi

    builtin print -u2 -r -- \
        "yt-timelapse: part ${part} ended; checking for a continuing live broadcast in 2s"

    builtin zselect -t 200
done
