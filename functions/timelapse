builtin enable emulate zmodload zparseopts zselect strftime print printf command
builtin emulate -LR zsh
builtin zmodload zsh/zutil zsh/zselect zsh/datetime zsh/mathfunc
builtin setopt pipefail functionargzero

local -a opt_multi opt_help opt_ext
local -a opt_fps opt_sample_rate opt_audio opt_audio_sample_mode
local -a muxer_args streamlink_args audio_args audio_codec_args ffmpeg_input_args
local -a tempo_filters pipeline_rc

builtin zparseopts -D -E -F -- \
    m=opt_multi \
    -multi=opt_multi \
    e:=opt_ext \
    -ext:=opt_ext \
    f:=opt_fps \
    -fps:=opt_fps \
    s:=opt_sample_rate \
    -sample-rate:=opt_sample_rate \
    a:=opt_audio \
    -audio:=opt_audio \
    -audio-sample-mode:=opt_audio_sample_mode \
    h=opt_help \
    -help=opt_help ||
    return 2

if (( ${#opt_help} )); then
    builtin command cat <<EOF
usage:
  $0 [options] <source> [output]

capture:
  SOURCE                      Streamlink URL or local media file
  -m, --multi                 follow a live broadcast across reconnects
                              (Streamlink sources only)
  -e, --ext EXT               output extension/container (default: mts)

sampling:
  -f, --fps FPS               output frame rate (default: 30)
  -s, --sample-rate RATE      input sampling cadence (default: 1s)

  RATE forms:
    1s       one frame per source second
    500ms    one frame per 500 ms
    30f      every 30th decoded input frame
    1f       every decoded input frame

audio:
  -a, --audio MODE            none | scaled | sample (default: none)
      --audio-sample-mode MODE
                              frame | hold | interpolate | spectral-hold
                              | spectral-interpolate (default: frame)

examples:
  $0 URL
  $0 ./video.mp4
  $0 ./video.mp4 output.mkv
  $0 --audio scaled ./audio.flac
  $0 --audio sample --audio-sample-mode spectral-hold ./audio.flac
  $0 --multi URL
  $0 --fps 60 --sample-rate 2s URL
  $0 --fps 29.97 --audio sample --audio-sample-mode spectral-interpolate ./audio.flac
  $0 --sample-rate 1f --fps 300 URL
  $0 --audio scaled URL
  $0 --audio sample --audio-sample-mode hold URL
EOF
    return 0
fi

integer multi=${#opt_multi}
integer part=0
integer rc=0
integer streamlink_rc=0
integer ffmpeg_rc=0
integer sample_frames=0
integer fps_anchor=0
integer audio_retime_rate=0
integer audio_sample_stride=0
integer frame_gate_samples=64
integer frame_window_samples=0
integer frame_audio_rate=0
integer hold_audio_rate=0
integer spectral_hop_samples=0
integer spectral_fft_size=4096
integer source_is_file=0
integer source_has_video=1
integer source_has_audio=0
integer audio_only=0

local source=''
local url=''
local output=''
local output_ext=''
local extension='mts'
local explicit_ext=''
local current_output=''
local timestamp=''
local stream_url=''
local playlist=''
local ext_lower=''
local probe_video=''
local probe_audio=''

local fps='30'
local sample_rate='1s'
local sample_kind=''
local sample_value=''
local sample_interval_expr=''

local audio='none'
local audio_sample_mode='frame'
local video_filter=''
local audio_filter=''

local tempo_text=''
local sample_seconds_text=''
local frame_duration_text=''
local spectral_overlap_text=''
local spectral_temporal_filter=''
local spectral_internal_fps=''
local spectral_filter_complex=''

local -F 12 fps_value=30.0
local -F 12 sample_seconds=1.0
local -F 12 frame_duration=0.033333333333
local -F 12 speed_factor=30.0
local -F 12 tempo_remaining=1.0
local -F 12 spectral_overlap=0.0

if (( ${#opt_ext} )); then
    explicit_ext=${opt_ext[-1]}
    explicit_ext=${explicit_ext#.}

    if [[ -z $explicit_ext || $explicit_ext == */* ]]; then
        builtin print -u2 -r -- \
            "$0: invalid extension: ${explicit_ext:-<empty>}"
        return 2
    fi
fi

if (( ${#opt_fps} )); then
    fps=${opt_fps[-1]}
fi

if (( ${#opt_sample_rate} )); then
    sample_rate=${opt_sample_rate[-1]}
fi

if (( ${#opt_audio} )); then
    audio=${(L)opt_audio[-1]}
fi

if (( ${#opt_audio_sample_mode} )); then
    audio_sample_mode=${(L)opt_audio_sample_mode[-1]}
fi

#
# FPS
#

if [[ $fps != <-> && $fps != <->.<-> ]]; then
    builtin print -u2 -r -- \
        "$0: invalid --fps: $fps"
    return 2
fi

(( fps_value = fps ))

if (( fps_value <= 0 )); then
    builtin print -u2 -r -- \
        "$0: --fps must be greater than zero"
    return 2
fi

#
# Sampling cadence
#

case $sample_rate {
    (*ms)
        sample_value=${sample_rate%ms}

        if [[ $sample_value != <-> &&
              $sample_value != <->.<-> ]]; then
            builtin print -u2 -r -- \
                "$0: invalid --sample-rate: $sample_rate"
            return 2
        fi

        (( sample_seconds = sample_value / 1000.0 ))
        sample_interval_expr="(${sample_value}/1000)"
        sample_kind=time
        ;;

    (*s)
        sample_value=${sample_rate%s}

        if [[ $sample_value != <-> &&
              $sample_value != <->.<-> ]]; then
            builtin print -u2 -r -- \
                "$0: invalid --sample-rate: $sample_rate"
            return 2
        fi

        (( sample_seconds = sample_value ))
        sample_interval_expr=$sample_value
        sample_kind=time
        ;;

    (*f)
        sample_value=${sample_rate%f}

        if [[ $sample_value != <-> ]]; then
            builtin print -u2 -r -- \
                "$0: frame sample rates must be whole frames: $sample_rate"
            return 2
        fi

        sample_frames=$sample_value

        if (( sample_frames <= 0 )); then
            builtin print -u2 -r -- \
                "$0: frame sample rate must be greater than zero"
            return 2
        fi

        sample_kind=frame
        ;;

    (*)
        builtin print -u2 -r -- \
            "$0: --sample-rate requires s, ms, or f: $sample_rate"
        return 2
        ;;
}

if [[ $sample_kind == time ]] && (( sample_seconds <= 0 )); then
    builtin print -u2 -r -- \
        "$0: --sample-rate must be greater than zero"
    return 2
fi

#
# Audio
#

case $audio {
    (none|scaled|sample)
        ;;
    (*)
        builtin print -u2 -r -- \
            "$0: invalid --audio mode: $audio"
        return 2
        ;;
}

case $audio_sample_mode {
    (frame|hold|interpolate|spectral-hold|spectral-interpolate)
        ;;
    (*)
        builtin print -u2 -r -- \
            "$0: invalid --audio-sample-mode: $audio_sample_mode"
        return 2
        ;;
}

if (( ${#opt_audio_sample_mode} )) &&
   [[ $audio != sample ]]; then
    builtin print -u2 -r -- \
        "$0: --audio-sample-mode requires --audio sample"
    return 2
fi

#
# There is deliberately no guessed audio mapping for Nf sampling.
#
# With VFR input, "every N decoded frames" has no single constant mapping
# from source audio time to output time.
#

if [[ $sample_kind == frame && $audio != none ]]; then
    builtin print -u2 -r -- \
        "$0: audio currently requires a time-based --sample-rate"
    return 2
fi

#
# Build video sampling filter.
#

if [[ $sample_kind == time ]]; then
    #
    # eof_action=pass is important for sparse sampling.  Without it, fps's
    # default EOF rounding can discard a perfectly valid final sample near
    # EOF (for example 44 s sampled every 21 s would yield only 0 s + 21 s,
    # losing the 42 s sample).
    #
    # The final fps pass is deliberately at the already-retimed output rate.
    # It does not invent intermediate frames: PTS are already N/FPS.  Its job
    # is to restore an explicit frame duration/rate after setpts:strip_fps.
    # MP4/MOV otherwise can drop the final sparse frame when using
    # -fps_mode passthrough because that last frame has no usable duration.
    #
    video_filter="setpts=PTS-STARTPTS,fps=fps=1/${sample_interval_expr}:eof_action=pass,settb=expr=1/${fps},setpts=expr=N:strip_fps=1,fps=fps=${fps}:eof_action=pass"

    (( frame_duration = 1.0 / fps_value ))
    (( speed_factor = fps_value * sample_seconds ))

    builtin printf -v sample_seconds_text \
        '%.12g' $sample_seconds

    builtin printf -v frame_duration_text \
        '%.12g' $frame_duration
else
    # As above, the final fps pass only restores the declared output cadence
    # and last-frame duration after retiming; the selected frames already have
    # exact consecutive output PTS.
    video_filter="select=not(mod(n\\,${sample_frames})),settb=expr=1/${fps},setpts=expr=N:strip_fps=1,fps=fps=${fps}:eof_action=pass"
fi

#
# Build audio filter.
#

audio_args=()

case $audio {
    (none)
        audio_args+=(
            -an
        )
        ;;

    (scaled)
        #
        # Pitch-preserving continuous time scaling.
        #
        # atempo accepts a bounded range, so factor large/small scales
        # into multiple stages.
        #

        tempo_filters=()
        tempo_remaining=$speed_factor

        while (( tempo_remaining > 2.0 )); do
            tempo_filters+=('atempo=2')
            (( tempo_remaining /= 2.0 ))
        done

        while (( tempo_remaining < 0.5 )); do
            tempo_filters+=('atempo=0.5')
            (( tempo_remaining /= 0.5 ))
        done

        if (( abs(tempo_remaining - 1.0) > 0.0000001 )); then
            builtin printf -v tempo_text \
                '%.12g' $tempo_remaining

            tempo_filters+=(
                "atempo=${tempo_text}"
            )
        fi

        if (( ! ${#tempo_filters} )); then
            tempo_filters=('anull')
        fi

        audio_filter="asetpts=PTS-STARTPTS,${(j:,:)tempo_filters},aresample=48000,asetpts=N/SR/TB"

        audio_args+=(
            -map '0:a:0?'
            -af "$audio_filter"
        )
        ;;

    (sample)
        #
        # Sampled audio supports decimal FPS too.  FFmpeg's asetrate filter
        # itself accepts only an integer sample rate, so modes that need a
        # rate reinterpretation use an integer anchor plus a near-48-kHz
        # correction stage.  That keeps the frame-index geometry tied to the
        # requested (possibly fractional) FPS without rounding 29.97 -> 30.
        #

        if (( fps_value > 48000.0 )); then
            builtin print -u2 -r -- \
                '--audio sample requires --fps <= 48000'
            return 2
        fi

        (( fps_anchor = floor(fps_value + 0.5) ))

        if (( fps_anchor < 1 )); then
            fps_anchor=1
        elif (( fps_anchor > 48000 )); then
            fps_anchor=48000
        fi

        # After reconstructing sampled points at fps_anchor, reinterpret the
        # resulting 48-kHz PCM at this rate and resample back to 48 kHz.
        # Duration then becomes N / requested_FPS rather than N / fps_anchor.
        (( audio_retime_rate = floor(48000.0 * fps_value / fps_anchor + 0.5) ))

        if (( audio_retime_rate < 1 )); then
            builtin print -u2 -r -- \
                "$0: --fps is too low for sampled audio at 48 kHz"
            return 2
        fi

        #
        # Literal audio decimation foundation for hold/interpolate.
        #
        # First normalize to 48 kHz, split into one-sample AVFrames, and
        # select exactly one PCM sample at each source sampling point.
        # Do NOT use aresample to reduce directly to FPS here: that would
        # anti-alias/low-pass before decimation and mostly erase ordinary
        # audio at timelapse-scale sample rates.
        #

        (( audio_sample_stride = 48000.0 * sample_seconds + 0.5 ))

        if (( audio_sample_stride < 1 )); then
            builtin print -u2 -r -- \
                "$0: --sample-rate is smaller than one 48 kHz audio sample"
            return 2
        fi

        case $audio_sample_mode {
            (frame)
                #
                # Keep a real, normal-speed 1/FPS audio window at every
                # source sampling point, discard the gap, then repack
                # surviving PCM continuously.
                #

                if (( speed_factor < 1.0 )); then
                    builtin print -u2 -r -- \
                        '--audio-sample-mode frame does not currently support overlapping samples (speed < 1x)'
                    return 2
                fi

                if (( abs(speed_factor - 1.0) < 0.0000001 )); then
                    audio_filter='asetpts=PTS-STARTPTS,aresample=48000,asetpts=N/SR/TB'
                else
                    #
                    # Select by integer PCM sample counts rather than timestamp
                    # modulo.  This avoids both floating-boundary error and the
                    # old up-to-128-sample overrun at every sampled window.
                    #
                    (( frame_window_samples = floor(48000.0 / fps_value + 0.5) ))

                    if (( frame_window_samples < 1 )); then
                        frame_window_samples=1
                    fi

                    frame_gate_samples=64

                    if (( frame_gate_samples > frame_window_samples )); then
                        frame_gate_samples=$frame_window_samples
                    fi

                    if (( frame_gate_samples > audio_sample_stride )); then
                        frame_gate_samples=$audio_sample_stride
                    fi

                    while (( frame_gate_samples > 1 &&
                              (frame_window_samples % frame_gate_samples ||
                               audio_sample_stride % frame_gate_samples) )); do
                        (( frame_gate_samples-- ))
                    done

                    # A fractional FPS usually means 48000/FPS is not an integer
                    # number of PCM samples.  Keep the nearest real source window,
                    # then apply only the tiny rate correction needed to make each
                    # concatenated window exactly one output-frame long on average.
                    (( frame_audio_rate = floor(frame_window_samples * fps_value + 0.5) ))

                    if (( frame_audio_rate < 1 )); then
                        frame_audio_rate=1
                    fi

                    audio_filter="asetpts=PTS-STARTPTS,aresample=48000,asetnsamples=n=${frame_gate_samples}:p=0,aselect=lt(mod(n*${frame_gate_samples}\\,${audio_sample_stride})\\,${frame_window_samples}),asetpts=N/SR/TB,asetrate=${frame_audio_rate},aresample=48000,asetpts=N/SR/TB"
                fi
                ;;

            (interpolate)
                #
                # Literal sample + interpolation:
                #
                #   48 kHz PCM
                #     -> one-sample AVFrames
                #     -> keep one exact sample every sample interval
                #     -> repack those samples at output FPS
                #     -> interpolate/reconstruct to 48 kHz
                #
                # filter_type=cubic with filter_size=4 gives a compact
                # interpolation kernel instead of the old pre-decimation
                # anti-alias filter that reduced this mode to a spectral ghost.
                #

                audio_filter="asetpts=PTS-STARTPTS,aresample=48000,asetnsamples=n=1:p=0,aselect=not(mod(n\\,${audio_sample_stride})),asetpts=N/SR/TB,asetrate=${fps_anchor},aresample=48000:filter_type=cubic:filter_size=4,asetrate=${audio_retime_rate},aresample=48000:filter_type=cubic:filter_size=4,asetpts=N/SR/TB"
                ;;

            (hold)
                #
                # Literal zero-order hold.
                #
                # At 48 kHz, capture the exact PCM value at each source
                # sampling point and keep that value until the next point.
                # Then reinterpret the held stream fast enough that each
                # source sampling interval becomes exactly one output frame.
                #

                (( hold_audio_rate = floor(fps_value * audio_sample_stride + 0.5) ))

                if (( hold_audio_rate < 1 )); then
                    builtin print -u2 -r -- \
                        "$0: --fps/--sample-rate combination is too low for hold audio"
                    return 2
                fi

                audio_filter="asetpts=PTS-STARTPTS,aresample=48000,aeval=if(eq(mod(n\\,${audio_sample_stride})\\,0)\\,st(ch\\,val(ch))\\,ld(ch)):c=same,asetrate=${hold_audio_rate},aresample=48000:filter_size=1,asetpts=N/SR/TB"
                ;;


            (spectral-hold|spectral-interpolate)
                #
                # Spectral sampling with a continuous phase donor.
                #
                # Magnitude is sampled at the requested source cadence and then
                # held or interpolated on the compressed timeline.
                #
                # Phase comes from a pitch-preserving continuous time-compression
                # of the source audio.  Using concatenated source snippets as the
                # phase donor seems attractive, but each snippet boundary resets to
                # the source phase at a different source time.  A constant tone can
                # therefore acquire FPS-spaced sidebands merely because 1/FPS is
                # not an integer number of its cycles.  Continuous atempo phase
                # avoids that reset while leaving magnitude sampling in charge of
                # the actual timelapse character.
                #
                # The fixed 4096-point Hann analysis defines the intended spectral
                # geometry. A 512-sample synthesis hop (87.5% overlap) is numerical
                # resolution only; reducing it further should converge rather than
                # move an audible implementation comb.
                #

                spectral_hop_samples=512

                if (( fps_value * spectral_hop_samples > 48000.0 )); then
                    (( spectral_hop_samples = floor(48000.0 / fps_value) ))
                fi

                if (( spectral_hop_samples < 1 )); then
                    spectral_hop_samples=1
                fi

                spectral_internal_fps="48000/${spectral_hop_samples}"

                (( spectral_overlap = 1.0 - spectral_hop_samples / (1.0 * spectral_fft_size) ))

                builtin printf -v spectral_overlap_text \
                    '%.12g' $spectral_overlap

                # Build the same safe atempo chain as --audio scaled, but use it
                # only as a phase donor.  Every stage stays in [0.5, 2.0].
                tempo_filters=()
                tempo_remaining=$speed_factor

                while (( tempo_remaining > 2.0 )); do
                    tempo_filters+=('atempo=2')
                    (( tempo_remaining /= 2.0 ))
                done

                while (( tempo_remaining < 0.5 )); do
                    tempo_filters+=('atempo=0.5')
                    (( tempo_remaining /= 0.5 ))
                done

                if (( abs(tempo_remaining - 1.0) > 0.0000001 )); then
                    builtin printf -v tempo_text \
                        '%.12g' $tempo_remaining

                    tempo_filters+=(
                        "atempo=${tempo_text}"
                    )
                fi

                if (( ! ${#tempo_filters} )); then
                    tempo_filters=('anull')
                fi

                if [[ $audio_sample_mode == spectral-hold ]]; then
                    spectral_temporal_filter="fps=fps=${spectral_internal_fps}"
                else
                    # Magnitude is represented in log scale, so linear pixel
                    # interpolation is a geometric-style amplitude morph.
                    spectral_temporal_filter="framerate=fps=${spectral_internal_fps}:interp_start=0:interp_end=255:scene=100"
                fi

                spectral_filter_complex="[0:a:0]asetpts=PTS-STARTPTS,aresample=48000,aformat=channel_layouts=stereo,asplit=2[spec_mag_audio][spec_phase_audio];[spec_mag_audio]showspectrum=s=1x${spectral_fft_size}:slide=fullframe:mode=separate:color=channel:scale=log:win_func=hann:overlap=${spectral_overlap_text}:data=magnitude,fps=fps=1/${sample_seconds_text},settb=expr=1/${fps},setpts=N,${spectral_temporal_filter},settb=expr=${spectral_hop_samples}/48000,setpts=N[spec_mag];[spec_phase_audio]${(j:,:)tempo_filters},aresample=48000,asetpts=N/SR/TB,showspectrum=s=1x${spectral_fft_size}:slide=fullframe:mode=separate:color=channel:scale=lin:win_func=hann:overlap=${spectral_overlap_text}:data=phase,settb=expr=${spectral_hop_samples}/48000,setpts=N[spec_phase];[spec_mag][spec_phase]spectrumsynth=channels=2:sample_rate=48000:scale=log:slide=fullframe:win_func=hann:overlap=${spectral_overlap_text},aformat=channel_layouts=stereo,asetpts=N/SR/TB[spectral_audio]"
                ;;
        }

        if [[ $audio_sample_mode == spectral-* ]]; then
            audio_args+=(
                -filter_complex "$spectral_filter_complex"
                -map '[spectral_audio]'
            )
        else
            audio_args+=(
                -map '0:a:0?'
                -af "$audio_filter"
            )
        fi
        ;;
}

#
# Output naming/container and source probing.
#

if (( multi )); then
    if (( $# != 1 )); then
        builtin print -u2 -r -- \
            "$0: --multi takes exactly one URL; filenames are automatic"
        return 2
    fi

    source=$1

    if [[ -f $source ]]; then
        builtin print -u2 -r -- \
            "$0: --multi is only supported for Streamlink sources"
        return 2
    fi

    url=$source
    extension=${explicit_ext:-mts}
else
    if (( $# < 1 || $# > 2 )); then
        builtin print -u2 -r -- \
            "usage: $0 [options] <source> [output]"
        return 2
    fi

    source=$1
    output=${2-}

    if [[ -f $source ]]; then
        source_is_file=1

        probe_video=$(
            builtin command ffprobe \
                -v error \
                -select_streams v:0 \
                -show_entries stream=index \
                -of csv=p=0 \
                "$source"
        )
        probe_audio=$(
            builtin command ffprobe \
                -v error \
                -select_streams a:0 \
                -show_entries stream=index \
                -of csv=p=0 \
                "$source"
        )

        if [[ -z $probe_video ]]; then
            source_has_video=0
        fi

        if [[ -n $probe_audio ]]; then
            source_has_audio=1
        fi

        if (( ! source_has_video )); then
            if (( ! source_has_audio )); then
                builtin print -u2 -r -- \
                    "$0: local file has neither video nor audio streams"
                return 2
            fi

            if [[ $audio == none ]]; then
                builtin print -u2 -r -- \
                    "$0: audio-only input requires --audio != none"
                return 2
            fi

            audio_only=1
        fi
    else
        url=$source
    fi

    if [[ -n $output ]]; then
        output_ext=${output:t:e}

        if [[ -n $output_ext ]]; then
            extension=$output_ext

            if [[ -n $explicit_ext &&
                  ${(L)explicit_ext} != ${(L)output_ext} ]]; then
                builtin print -u2 -r -- \
                    "$0: --ext .${explicit_ext} conflicts with output .${output_ext}"
                return 2
            fi
        else
            if (( audio_only )); then
                extension=${explicit_ext:-mts}
            else
                extension=${explicit_ext:-mts}
            fi
            output="${output}.${extension}"
        fi
    else
        if (( audio_only )); then
            extension=${explicit_ext:-mts}
        else
            extension=${explicit_ext:-mts}
        fi
    fi
fi

ext_lower=${(L)extension}
muxer_args=()

case $ext_lower {
    (ts|mts|m2t|m2ts)
        muxer_args+=(
            -mpegts_flags +pat_pmt_at_frames
        )
        ;;

    (mp4|m4v|mov)
        muxer_args+=(
            -tag:v hvc1
            -movflags +faststart
        )
        ;;
    (m4a)
        muxer_args+=(
            -movflags +faststart
        )
        ;;
}


audio_codec_args=()

if [[ $audio != none ]]; then
    case $ext_lower {
        (flac)
            audio_codec_args+=(
                -c:a flac
                -ar 48000
            )
            ;;

        (*)
            audio_codec_args+=(
                -c:a aac
                -b:a 128k
                -ar 48000
            )
            ;;
    }
fi

#
# Main capture/reconnect loop.
#

while (( 1 )); do
    if (( multi )); then
        while (( 1 )); do
            stream_url=$(
                builtin command streamlink \
                    --stream-url \
                    "$url" best \
                    2>/dev/null
            )
            rc=$?

            if (( rc )) || [[ -z $stream_url ]]; then
                builtin print -u2 -r -- \
                    "$0: stream unavailable; retrying in 2s"
                builtin zselect -t 200
                continue
            fi

            playlist=$(
                builtin command /usr/bin/curl \
                    -LfsS \
                    --max-time 15 \
                    "$stream_url" \
                    2>/dev/null
            )
            rc=$?

            if (( rc )) || [[ -z $playlist ]]; then
                builtin print -u2 -r -- \
                    "$0: could not inspect stream; retrying in 2s"
                builtin zselect -t 200
                continue
            fi

            if [[ $playlist == *'#EXT-X-STREAM-INF'* ]]; then
                stream_url=$(
                    builtin command streamlink \
                        --stream-url \
                        "$stream_url" best \
                        2>/dev/null
                )
                rc=$?

                if (( rc )) || [[ -z $stream_url ]]; then
                    builtin print -u2 -r -- \
                        "$0: could not resolve media playlist; retrying in 2s"
                    builtin zselect -t 200
                    continue
                fi

                playlist=$(
                    builtin command /usr/bin/curl \
                        -LfsS \
                        --max-time 15 \
                        "$stream_url" \
                        2>/dev/null
                )
                rc=$?

                if (( rc )) || [[ -z $playlist ]]; then
                    builtin print -u2 -r -- \
                        "$0: could not inspect media playlist; retrying in 2s"
                    builtin zselect -t 200
                    continue
                fi
            fi

            if [[ $playlist == *'#EXT-X-ENDLIST'* ||
                  $playlist == *'#EXT-X-PLAYLIST-TYPE:VOD'* ]]; then
                if (( part )); then
                    builtin print -u2 -r -- \
                        "$0: broadcast ended; finished"
                    return 0
                fi

                builtin print -u2 -r -- \
                    "$0: --multi requires a currently-live broadcast"
                return 3
            fi

            if [[ $playlist == '#EXTM3U'* &&
                  ( $playlist == *'#EXTINF:'* ||
                    $playlist == *'#EXT-X-MEDIA-SEQUENCE:'* ) ]]; then
                break
            fi

            builtin print -u2 -r -- \
                "$0: unclear playlist state; retrying in 2s"

            builtin zselect -t 200
        done
    fi

    (( part++ ))

    if (( multi )); then
        builtin strftime -s timestamp '%Y-%m-%d_%H-%M-%S'
        current_output="${timestamp}_part_${part}_timelapse.${extension}"
    elif [[ -n $output ]]; then
        current_output=$output
    else
        builtin strftime -s timestamp '%Y-%m-%d_%H-%M-%S'
        current_output="${timestamp}_timelapse.${extension}"
    fi

    if (( multi )); then
        builtin print -u2 -r -- \
            "$0: recording part ${part} -> ${current_output}"
    else
        builtin print -u2 -r -- \
            "$0: recording -> ${current_output}"
    fi

    builtin print -u2 -r -- \
        "$0: ${sample_rate} -> ${fps} fps; audio=${audio}${${(M)audio:#sample}:+/${audio_sample_mode}}"

    streamlink_args=()
    ffmpeg_input_args=()

    if (( source_is_file )); then
        ffmpeg_input_args+=(
            -i "$source"
        )
    else
        ffmpeg_input_args+=(
            -fflags nobuffer
            -i -
        )

        if (( multi )); then
            streamlink_args+=(
                --retry-streams 2
                --retry-max 0
            )
        fi
    fi

    if (( source_is_file )); then
        if (( audio_only )); then
            builtin command ffmpeg \
                "${ffmpeg_input_args[@]}" \
                "${audio_args[@]}" \
                "${audio_codec_args[@]}" \
                -vn \
                -flush_packets 1 \
                -avioflags direct \
                "${muxer_args[@]}" \
                "$current_output"
        else
            builtin command ffmpeg \
                "${ffmpeg_input_args[@]}" \
                -map 0:v:0 \
                "${audio_args[@]}" \
                "${audio_codec_args[@]}" \
                -vf "$video_filter" \
                -fps_mode passthrough \
                -enc_time_base filter \
                -c:v hevc_videotoolbox \
                -bf 0 \
                -realtime 1 \
                -q:v 65 \
                -pix_fmt yuv420p \
                -flush_packets 1 \
                -avioflags direct \
                "${muxer_args[@]}" \
                "$current_output"
        fi

        ffmpeg_rc=$?
        streamlink_rc=0
    else
        builtin command streamlink \
            "${streamlink_args[@]}" \
            "$url" best -O |
        builtin command ffmpeg \
            "${ffmpeg_input_args[@]}" \
            -map 0:v:0 \
            "${audio_args[@]}" \
            "${audio_codec_args[@]}" \
            -vf "$video_filter" \
            -fps_mode passthrough \
            -enc_time_base filter \
            -c:v hevc_videotoolbox \
            -bf 0 \
            -realtime 1 \
            -q:v 65 \
            -pix_fmt yuv420p \
            -flush_packets 1 \
            -avioflags direct \
            "${muxer_args[@]}" \
            "$current_output"

        #
        # SAVE THIS IMMEDIATELY.
        #
        pipeline_rc=("${pipestatus[@]}")

        streamlink_rc=${pipeline_rc[1]}
        ffmpeg_rc=${pipeline_rc[2]}
    fi

    #
    # FFmpeg explicitly reports handled termination signals as 255.
    # One Ctrl+C therefore means STOP, not "please reconnect".
    #

    if (( ffmpeg_rc == 255 )); then
        return 255
    fi

    #
    # Fallback if Streamlink saw SIGINT but FFmpeg happened to finish
    # without its own signal status.
    #

    if (( streamlink_rc == 130 )); then
        return 130
    fi

    #
    # A genuine FFmpeg/filter/encoder failure should not become an
    # infinite --multi reconnect loop.
    #

    if (( ffmpeg_rc )); then
        return $ffmpeg_rc
    fi

    if (( ! multi )); then
        return $streamlink_rc
    fi

    builtin print -u2 -r -- \
        "$0: part ${part} ended; checking for continuation in 2s"

    builtin zselect -t 200
done
